# Added on branch feffjl/phase1-subroutines. Upstream FEFF10 ships no .gitignore,
# so an in-tree build leaves thousands of untracked artifacts and `git status`
# becomes useless for reviewing the Phase-1 source changes.
# Nothing matched here was tracked before (git ls-files '*.o' and '*.mod' are both
# empty), so this hides only generated files.

# Compiler output
*.o
*.mod
src/DEP.bak/

# Built executables
bin/Seq/
bin/MPI/

# Phase 2 gfortran build: tools/build_lib.sh puts the executable in bin/gfortran
# (bin/gfortran-dbg for --debug) and the libraries in lib/ (lib-dbg/), keeping
# them clear of the ifort output in bin/Seq.
bin/gfortran/
bin/gfortran-dbg/
lib/
lib-dbg/

# Makefile copies PAR/sequential.src (or parallel.src) here at build time.
src/PAR/parallel.f90

# Makefile does `cp Compiler.mk.default Compiler.mk` if absent -- the copy is the
# machine-local toolchain config, not a source file.
src/Compiler.mk

# Generated by Utility/MkFeffScript, with an absolute FeffPath baked in.
bin/feff
bin/feffmpi

# Stray outputs from running the executables inside bin/.
bin/density.inp
bin/fort.*
bin/log*.dat

# Phase 3: gfortran invents fort.<unit> in the CURRENT directory when something
# writes to an unopened unit, so probing libfeff.so from src/ can leave a fort.11
# there. The write itself is now guarded (COMMON/m_feff_status.f90 inquires whether
# unit 11 is open before using wlog), but the file is generated either way and
# should never be committed.
src/fort.*
